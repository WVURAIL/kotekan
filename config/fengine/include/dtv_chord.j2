# -*-yaml-*-

# CHORD PilotProxy detector; see docs/sphinx/user/modules/pilotproxy.rst.
# Bind local coarse_freq IDs to runtime-bundle chord_channel_id entries.
# Non-pilot channels emit zero mask/power products.
# One 8192-sample block is 41.94304 ms at CHORD's 195.3125 kHz sample rate:
# 128 detector windows of 64 samples, aligned with one n2k integration.
# Every cudaProcess on a GPU shares one set of CUDA streams. The F-engine and
# n2k use the defaults (copies in on 0, copies out on 1, kernels on 2), so the
# detector runs its kernels on stream 3 and copies its products out on stream 4,
# and queues behind neither.
# Optional switches (defaults keep the fail-stop detector that sums every input):
#   dtv_control_freq_ids          receiver IDs of the channel 37 noise control
#                                 (decided and recorded, never applied)
#   dtv_exclude_bad_inputs        exclude inputs the bad feed mask flags
#   dtv_runtime_failure_mode      "stop" or "degrade" on a run-time detector error
#   dtv_missing_decision_action   "stop" or "mask" for a missing required decision
#   dtv_decision_deadline_s       seconds DtvRfiMask waits for a decision (0: no limit)
#   dtv_decouple_detector         the detector reads its own copy of the voltages, which a
#                                 copy buffer full for dtv_detach_timeout_s (default 1 s)
#                                 detaches, so a stalled detector cannot hold the
#                                 correlator's voltage ring (set a deadline)
# With dtv_apply_mask and dtv_missing_decision_action "mask", frames without a decision
# count as lost (n2k packet-loss counts), not as RFI.
{% set dtv_decouple = dtv_decouple_detector|default(false) %}
{% set dtv_voltage = "dtv_voltage" if dtv_decouple else "voltage" %}
{% set dtv_lost = dtv_apply_mask|default(false) and dtv_missing_decision_action|default("stop") == "mask" %}


################################################################################

# Buffers

{% if dtv_decouple %}
# The detector's copy of the voltages; bufferCopy detaches it when it stays full.
host_dtv_voltage_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: int4x2_swapped_withoffset
    extents: [num_times, num_frequencies, num_polarizations, num_dishes]
    quantity_name: "E"
    dimnames: ["T", "F", "P", "D"]
    dimscalings: [1, 1, 1, 1]
    metadata_pool: main_pool
host_dtv_voltage_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * num_dishes * num_polarizations * num_frequencies * num_times
    metadata_pool: main_pool

run_copy_dtv_voltage:
    kotekan_stage: bufferCopy
    in_buf: host_voltage_buffer
    out_bufs:
        - host_dtv_voltage_buffer
    detach_timeout_s: {{ dtv_detach_timeout_s|default(1.0) }}

run_send_dtv_voltage:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_dtv_voltage_buffer: host_dtv_voltage_buffer
        out_buffers:
            host_dtv_voltage_ringbuffer: host_dtv_voltage_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: num_dishes * num_polarizations * num_frequencies * num_times
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_dtv_voltage_buffer
          signal_buf: host_dtv_voltage_ringbuffer
          gpu_mem_output: dtv_voltage_buffer
{% endif %}

host_dtv_mask_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: int8
    extents: [num_frequencies]
    quantity_name: "dtv_mask"
    dimnames: ["F"]
    dimscalings: [1]
    metadata_pool: main_pool

host_dtv_powers_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: uint64
    extents: [num_frequencies, 3]
    quantity_name: "dtv_powers"
    dimnames: ["F", "W"]
    dimscalings: [1, 1]
    metadata_pool: main_pool

host_dtv_fine_support_buffer:
    kotekan_buffer: ndarray
    num_frames: buffer_depth
    value_type: int32
    extents: [num_frequencies, 2]
    quantity_name: "dtv_fine_support"
    dimnames: ["F", "S"]
    dimscalings: [1, 1]
    metadata_pool: main_pool

################################################################################

# Stages

run_dtv_detector:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        num_cuda_streams: 5
        in_buffers:
            host_{{ dtv_voltage }}_ringbuffer: host_{{ dtv_voltage }}_ringbuffer
{% if dtv_exclude_bad_inputs|default(false) %}
            host_bf_mask_ringbuffer: host_bf_mask_ringbuffer
{% endif %}
        out_buffers:
            host_dtv_mask: host_dtv_mask_buffer
            host_dtv_powers: host_dtv_powers_buffer
            host_dtv_fine_support: host_dtv_fine_support_buffer
        commands:
        - name: cudaPilotProxyDetector
          cuda_stream: 3
          voltage_name: {{ dtv_voltage }}
          detector_window_samples: 64
          dtv_mask_name: dtv_mask
          dtv_powers_name: dtv_powers
          dtv_fine_support_name: dtv_fine_support
          permanent_mask_freq_ids: {{ dtv_permanent_mask_freq_ids|default([]) }}
          control_freq_ids: {{ dtv_control_freq_ids|default([]) }}
          runtime_failure_mode: {{ dtv_runtime_failure_mode|default("stop") }}
{% if dtv_exclude_bad_inputs|default(false) %}
          bf_mask_name: bf_mask
{% endif %}
          pilot_profiles_path: {{ dtv_runtime_bundle_dir|default("data/pilotproxy_bundle") }}/pilot_profiles.json
          weights_path: {{ dtv_runtime_bundle_dir|default("data/pilotproxy_bundle") }}/weights.bin
        - name: cudaSyncOutput
          cuda_stream: 4
        - name: cudaOutputData
          cuda_stream: 4
          gpu_mem: dtv_mask_buffer
          out_buf: host_dtv_mask
        - name: cudaOutputData
          cuda_stream: 4
          gpu_mem: dtv_powers_buffer
          out_buf: host_dtv_powers
        - name: cudaOutputData
          cuda_stream: 4
          gpu_mem: dtv_fine_support_buffer
          out_buf: host_dtv_fine_support

# Both correlation and valid-sample counts must consume this opt-in mask.
{% if dtv_apply_mask|default(false) %}
host_dtv_RFImask_buffer:
    kotekan_buffer: ndarray
    num_frames: 4 * buffer_depth # as deep as host_rfi_RFImask_buffer, which it replaces
    value_type: uint1x8
    extents: [num_times / 1024, num_frequencies, 128]
    quantity_name: "RFImask"
    dimnames: ["T8hi128", "F", "T8lo128"]
    dimscalings: [1024, 1, 8]
    metadata_pool: main_pool

host_dtv_RFImask_ringbuffer:
    kotekan_buffer: ring
    ring_buffer_size: buffer_depth * num_frequencies * num_times / 8
    metadata_pool: main_pool

run_combine_dtv_mask:
    kotekan_stage: DtvRfiMask
    num_local_freq: num_frequencies
    rfi_buf: host_rfi_RFImask_buffer
    dtv_buf: host_dtv_mask_buffer
    fine_support_buf: host_dtv_fine_support_buffer
    permanent_mask_freq_ids: {{ dtv_permanent_mask_freq_ids|default([]) }}
    require_fine_freq_ids: {{ dtv_require_fine_freq_ids|default([]) }}
    control_freq_ids: {{ dtv_control_freq_ids|default([]) }}
    missing_decision_action: {{ dtv_missing_decision_action|default("stop") }}
    decision_deadline_s: {{ dtv_decision_deadline_s|default(0) }}
    out_buf: host_dtv_RFImask_buffer
{% if dtv_lost %}
    plcounts_in_buf: host_n2k_plcounts_buffer
    plcounts_out_buf: host_dtv_plcounts_buffer
    rfi_count_buf: host_dtv_rfi_count_buffer

# Missing decisions count as lost samples: N2Accumulate reads these packet-loss counts and
# RfiMaskSum reads the mask without the missing-decision exclusions.
host_dtv_plcounts_buffer:
    kotekan_buffer: ndarray
    num_frames: 4 * buffer_depth
    value_type: int32
    extents: [n2k_num_subintegrations, num_frequencies]
    quantity_name: "pl_lost_counts_scalar"
    dimnames: ["Tc", "F"]
    dimscalings: [n2k_sub_integration_ntime, 1]
    metadata_pool: main_pool

host_dtv_rfi_count_buffer:
    kotekan_buffer: ndarray
    num_frames: 4 * buffer_depth
    value_type: uint1x8
    extents: [num_times / 1024, num_frequencies, 128]
    quantity_name: "RFImask"
    dimnames: ["T8hi128", "F", "T8lo128"]
    dimscalings: [1024, 1, 8]
    metadata_pool: main_pool
{% endif %}

run_send_dtv_RFImask:
    gpu_0:
        kotekan_stage: cudaProcess
        gpu_id: 0
        in_buffers:
            host_dtv_RFImask_buffer: host_dtv_RFImask_buffer
        out_buffers:
            host_dtv_RFImask_ringbuffer: host_dtv_RFImask_ringbuffer
        commands:
        - name: cudaCopyToRingbuffer
          input_size: num_frequencies * num_times / 8
          ring_buffer_size: buffer_depth * input_size
          in_buf: host_dtv_RFImask_buffer
          signal_buf: host_dtv_RFImask_ringbuffer
          gpu_mem_output: dtv_RFImask_buffer
{% endif %}
